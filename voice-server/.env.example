# Порт сигналинг-сервера (nginx проксирует wss://hworks.space/voice сюда)
VOICE_SERVER_PORT=4000

# Публичный IP сервера (announcedIp для mediasoup). На локалке — 127.0.0.1
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

# Диапазон UDP-портов для WebRTC (открыть на фаерволе!)
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# Общий секрет с основным API (тем же значением в .env основного сервера)
VOICE_SECRET=change-me-to-a-long-random-string

# Разрешённый origin (как CLIENT_URL основного API)
CLIENT_URL=https://hworks.space
